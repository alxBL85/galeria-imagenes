datasource db {
  provider = "sqlite"
}

generator client {
  provider = "prisma-client"
  output = "./client"
}

model User {
  id          String  @id
  email       String  @unique
  password    String
  collections Collection[]
}

model Collection {
  id        String @id
  name      String
  type      String
  createdAt DateTime
  userId    String

  user      User @relation(fields: [userId], references: [id])
  images    Image[]
}

model Image {
  id            String @id
  name          String
  description   String
  path          String
  createdAt     DateTime
  collectionId  String

  collection    Collection @relation(fields: [collectionId], references: [id])
}